{
    "name": "alex-kassel/roach-php-core",
    "description": "A complete web scraping toolkit for PHP",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "scraping",
        "crawler",
        "spider",
        "scraper",
        "roach",
        "roach-php",
        "dom-crawler"
    ],
    "homepage": "https://github.com/alex-kassel/roach-php-core",
    "support": {
        "issues": "https://github.com/alex-kassel/roach-php-core/issues",
        "source": "https://github.com/alex-kassel/roach-php-core"
    },
    "authors": [
        {
            "name": "Kai Sassnowski",
            "email": "me@kai-sassnowski.com",
            "role": "Original Author"
        },
        {
            "name": "Alexander Macenko",
            "email": "alexander.macenko@gmail.com",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0",
        "guzzlehttp/guzzle": "^7.8.0 || ^8.0",
        "jakeasmith/http_build_url": "^1.0.1",
        "league/container": "^4.2",
        "monolog/monolog": "^3.5",
        "nyholm/psr7": "^1.8.1",
        "nyholm/psr7-server": "^1.1",
        "psr/container": "^2.0.2",
        "psy/psysh": "^0.11.22 || ^0.12.0",
        "spatie/robots-txt": "^2.0.3",
        "symfony/console": "^7.0 || ^8.0",
        "symfony/css-selector": "^7.0 || ^8.0",
        "symfony/dom-crawler": "^7.0 || ^8.0",
        "symfony/event-dispatcher": "^7.0 || ^8.0",
        "symfony/options-resolver": "^7.0 || ^8.0"
    },
    "require-dev": {
        "http-interop/http-factory-guzzle": "^1.2",
        "laravel/pint": "^1.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.4.2 || ^11.0 || ^12.0",
        "psr/http-message": "^1.1.0 || ^2.0",
        "roave/security-advisories": "dev-latest",
        "slim/slim": "^4.12",
        "spatie/browsershot": "^5.0"
    },
    "suggest": {
        "spatie/browsershot": "Required to execute Javascript in spiders"
    },
    "autoload": {
        "psr-4": {
            "RoachPHP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoachPHP\\Tests\\": "tests/"
        }
    },
    "bin": [
        "roach"
    ],
    "scripts": {
        "analyze": "vendor/bin/phpstan analyse src --configuration=phpstan.neon",
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
